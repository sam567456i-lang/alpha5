{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "format_version": {
      "type": "string"
    },
    "generated_by": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "checksum": {
      "type": "string"
    },
    "platform_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}$"
    },
    "name": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subsystems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "readiness": {
      "type": "object",
      "properties": {
        "architecture": {
          "type": "number"
        },
        "implementation": {
          "type": "number"
        },
        "validation": {
          "type": "number"
        },
        "performance": {
          "type": "number"
        },
        "documentation": {
          "type": "number"
        },
        "dashboard": {
          "type": "number"
        },
        "ai": {
          "type": "number"
        },
        "research": {
          "type": "number"
        },
        "testing": {
          "type": "number"
        },
        "governance": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "platform_id",
    "name",
    "readiness"
  ]
}