{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "format_version": {
      "type": "string"
    },
    "generated_by": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "checksum": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "roadmaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "external_repos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "architecture_score": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "repository",
    "platforms"
  ]
}