# AlphaGrid Infinity X 5.0 environment example.
# Secrets and machine-specific values must stay outside source code.

APP_ENV=development
APP_NAME=AlphaGrid Infinity X 5.0
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_TIMEOUT_SECONDS=30
HEALTH_TIMEOUT_SECONDS=5
SHUTDOWN_TIMEOUT_SECONDS=30

# Database values are consumed by the future Database module.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=alphagrid
POSTGRES_USER=alphagrid
POSTGRES_PASSWORD=change-me-outside-source-control
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT_SECONDS=30
POSTGRES_ECHO_SQL=false
DUCKDB_PATH=./data/alphagrid.duckdb
DUCKDB_READ_ONLY=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me-outside-source-control
REDIS_DEFAULT_TTL_SECONDS=300
REDIS_SOCKET_TIMEOUT_SECONDS=5
ALEMBIC_CONFIG_PATH=./Database/alembic.ini
ALEMBIC_SCRIPT_LOCATION=./Database/migrations
